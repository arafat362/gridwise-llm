# Copy to .env and fill in values. Never commit .env or bake secrets into Docker images.
APP_HOST=0.0.0.0
APP_PORT=8000

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1
OPENROUTER_SITE_URL=https://fest.bupcopc.tech
OPENROUTER_APP_NAME=GridWise-LLM
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000
